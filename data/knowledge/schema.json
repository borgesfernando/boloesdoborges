{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site.boloesdoborges.shop/data/knowledge/schema.json",
  "title": "Bolões do Borges Canonical Knowledge Dataset",
  "type": "object",
  "required": ["schemaVersion", "domain", "intents"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "intent", "examples", "answerType", "response", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "intent": { "type": "string", "minLength": 1 },
          "examples": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "answerType": { "enum": ["canonical", "dynamic", "hybrid", "human"] },
          "sensitive": { "type": "boolean", "default": false },
          "response": {
            "type": "object",
            "required": ["short", "standard"],
            "properties": {
              "short": { "type": "string", "minLength": 1 },
              "standard": { "type": "string", "minLength": 1 },
              "detailed": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "facts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "mustInclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "mustNotClaim": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "resolver": { "type": "string", "minLength": 1 },
          "relatedIntents": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" } },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "reference"],
              "properties": {
                "type": { "enum": ["faq", "documentation", "operational_state", "historical_dataset", "terms"] },
                "reference": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "answerType": { "enum": ["dynamic", "hybrid"] } }, "required": ["answerType"] },
            "then": { "required": ["resolver"] }
          },
          {
            "if": { "properties": { "sensitive": { "const": true } }, "required": ["sensitive"] },
            "then": { "required": ["mustInclude", "mustNotClaim"] }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
